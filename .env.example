# -------------------------------------------------------------
# Second Brain RAG — Environment Variables
# Copy this file to .env and fill in all values before running.
# NEVER commit .env to version control.
# -------------------------------------------------------------

# --- Backend API protection ---
# Comma-separated list of valid API keys (supports multiple clients).
API_KEYS=change-me-to-a-strong-secret
# Legacy single-key fallback (used if API_KEYS is not set):
API_KEY=change-me-to-a-strong-secret

# --- LLM Providers ---
GOOGLE_API_KEY=your_google_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# --- LLM Model Configuration ---
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
LLM_COOLDOWN_SECONDS=300
MAX_API_RETRIES=3

# --- Graph Database (Neo4j) ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-strong-neo4j-password

# --- Redis Cache ---
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=change-me-strong-redis-password
CACHE_BACKEND=redis

# --- ChromaDB ---
CHROMA_HOST=chroma
CHROMA_PORT=8001
CHROMA_AUTH_TOKEN=change-me-strong-chroma-token

# --- BM25 persistence path (inside the container) ---
BM25_DATA_DIR=/app/bm25_data

# --- Embedding & Reranking Models ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- RAG Tuning ---
CHUNK_SIZE=2000
CHUNK_OVERLAP=200
RERANK_THRESHOLD=-5.0
RRF_K=60
RETRIEVAL_MULTIPLIER=3
MAX_CONTEXT_TOKENS=4000
MAX_FILE_SIZE_MB=10

# --- CORS (comma-separated origins for the backend) ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80

# --- Logging ---
LOG_FORMAT=json

# --- OpenTelemetry (Observability) ---
OTEL_ENABLED=true
OTEL_SERVICE_NAME=second-brain-rag
OTEL_EXPORTER=console
# OTEL_OTLP_ENDPOINT=http://localhost:4317
